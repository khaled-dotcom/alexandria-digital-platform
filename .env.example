# انسخ الملف ده باسم .env ثم شغّل: npm run set-password

PORT=3000

# development أو production
NODE_ENV=development

# مفتاح توقيع الجلسات — بيتولّد أوتوماتيك مع npm run set-password
SESSION_SECRET=change-me-to-a-long-random-string

# الحسابات بتتخزّن في قاعدة البيانات (جدول users) مش هنا.
# اعمل حساب بـ: npm run set-password

# ── تصنيف البلاغات بالذكاء الاصطناعي (اختياري) ──────────────────────────
# من غير المفتاح ده الموقع بيشتغل عادي بس من غير تصنيف تلقائي للصور والنصوص.
# اعمل مفتاح من: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── الإشعارات (SMS) ─────────────────────────────────────────────────────
# console = بيطبع الرسالة في اللوج بدل ما يبعتها (للتطوير والعرض)
# http    = بيبعت لبوابة SMS حقيقية عبر SMS_ENDPOINT
SMS_PROVIDER=console
# SMS_ENDPOINT=https://api.your-sms-gateway.com/send
# SMS_API_KEY=
# SMS_SENDER=Alexandria

# ── المراقبة ────────────────────────────────────────────────────────────
# لو متظبّط، /metrics هيطلب Authorization: Bearer <التوكن>
# METRICS_TOKEN=

# ── حدود الطلبات (اختيارية) ─────────────────────────────────────────────
# حد البلاغات لكل IP — الافتراضي ٥ بلاغات كل ١٠ دقايق
# REPORT_RATE_MAX=5
# REPORT_RATE_WINDOW_MIN=10

# حد محاولات الدخول — الافتراضي ١٠ محاولات كل ١٥ دقيقة
# LOGIN_RATE_MAX=10
# LOGIN_RATE_WINDOW_MIN=15

# حد التقييمات — الافتراضي ٦٠ كل ساعة
# RATE_LIMIT_MAX=60

# حدود دخول المواطنين بالرقم القومي
# OTP_RATE_MAX=5              طلبات كود التحقق كل ١٥ دقيقة
# OTP_VERIFY_RATE_MAX=15      محاولات إدخال الكود كل ١٥ دقيقة
# OTP_COOLDOWN_SEC=60         المهلة بين طلبين للكود
# BOOKING_RATE_MAX=10         حجوزات المواعيد كل ساعة

# عدد البروكسيات قدام السيرفر (nginx = 1). مهم عشان حد الطلبات يقرأ الـ IP صح
# TRUST_PROXY=1

# مستوى السجلّ: debug | info | warn | error
# LOG_LEVEL=info
